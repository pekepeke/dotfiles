#!/bin/sh

is_exec() {
  which $1 > /dev/null 2>&1
  return $?
}
mkurl() {
  echo "github.com/"$1
}

mkdesktop() {
  [ -z "$1" ] && return 1
  local NAME=$1
  local BIN=$(which $1)
  local DESC=$2
  [ -z "$DESC" ] && DESC="$NAME"

  ICON_PREFIX="# "
  ICON_PATH=$HOME/.local/share/icons/xxx.png
  for ext in png svg ; do
    [ -e $HOME/.local/share/icons/$NAME.$ext ] && ICON_PATH=$HOME/.local/share/icons/$NAME.$ext
  done

  cat <<EOM
[Desktop Entry]
Version=1.0
Name=$NAME
GenericName=$DESC
Comment=$DESC
Exec=$BIN %F
Terminal=false
Type=Application
Categories=Development;
${ICON_PREFIX}Icon=$HOME/.local/share/icons/xxx.png
EOM
}
is_gui() {
  local FLAG=$(print_repos | grep $1 | awk '{print $2}')
  [ "$FLAG" = "" ] && return 1
  return 0
}
print_repos() {
  cat <<EOM
akiyosi/goneovim [GUI]
extrawurst/gitui
jesseduffield/lazydocker
jesseduffield/lazygit
sharkdp/vivid
zellij-org/zellij
ducaale/xh
starship/starship
tldr-pages/tlrc
denisidoro/navi
EOM
  cat <<EOM >/dev/null
junegunn/fzf
eza-community/eza
dandavison/delta
sharkdp/bat
EOM
}
install_after() {
  local FULL_PACKAGE=$1
  local PACKAGE=$(basename $FULL_PACKAGE)
  if is_gui $FULL_PACKAGE ; then
    mkdesktop $PACKAGE > ~/.local/share/applications/$PACKAGE.desktop
  fi
  # case $PACKAGE in
  #   *) ;;
  # esac
}

if ! is_exec bin; then

  INSTALL_DIR=~/.local/bin
  ARCH=`uname -m | sed 's/x86_64/amd64/' | sed 's/aarch64/arm64/'`

  curl -s https://api.github.com/repos/$AUTHOR/$PG/releases/latest > /tmp/bin.json
  CDIR=`pwd`

  DL_URL="$(cat /tmp/bin.json \
| grep "browser_download_url.*linux_$ARCH" \
| cut -d : -f 2,3 \
| tr -d \")"

  cd /tmp/
  echo curl -Lo bin $DL_URL
  curl -Lo bin $DL_URL
  chmod +x /tmp/bin
  mv /tmp/bin $INSTALL_DIR/bin

  cd $CDIR
fi
if ! is_exec fzf; then
  bin install github.com/junegunn/fzf
fi

ACTION="$1"
if [ ! -z "$ACTION" ]; then
  shift
else
  ACTION=install
fi

SELECTED=$(print_repos | fzf -m | awk 'print $1')

case $ACTION in
  install)
    for p in $SELECTED ; do
      if bin ensure $p >/dev/null 2>&1; then
        bin update $p
      else
        bin install $(mkurl $p)
        install_after $p
      fi
    done
    ;;
  open)
    xdg-open https://$(mkurl $p)
    ;;
esac
